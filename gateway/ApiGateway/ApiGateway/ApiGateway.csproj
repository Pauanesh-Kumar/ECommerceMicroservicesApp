<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>ApiGateway</RootNamespace>
    <AssemblyName>ApiGateway</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <!-- YARP Reverse Proxy -->
    <PackageReference Include="Yarp.ReverseProxy" Version="2.2.0" />

    <!-- JWT Authentication -->
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.0" />

    <!-- Serilog -->
    <PackageReference Include="Serilog.AspNetCore" Version="8.0.3" />
    <PackageReference Include="Serilog.Sinks.Console" Version="6.0.0" />
    <PackageReference Include="Serilog.Enrichers.CorrelationId" Version="3.0.1" />

    <!-- Health checks — downstream URL probes -->
    <PackageReference Include="Microsoft.Extensions.Diagnostics.HealthChecks" Version="10.0.0" />
    <PackageReference Include="AspNetCore.HealthChecks.Uris" Version="8.0.1" />

    <!-- Kafka producer (audit events only — no consumer in Gateway) -->
    <PackageReference Include="Confluent.Kafka" Version="2.6.0" />

    <!-- Polly resilience on HttpClient (retry + circuit-breaker) -->
    <PackageReference Include="Microsoft.Extensions.Http.Resilience" Version="9.3.0" />

    <!-- OpenAPI + Scalar UI — test the Gateway's own routes (aggregator + proxy) -->
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.9" />
    <PackageReference Include="Microsoft.OpenApi" Version="2.7.5" />
    <PackageReference Include="Scalar.AspNetCore" Version="2.16.10" />
    <!-- Scalar UI for OpenAPI explorer (replace Swashbuckle) -->
    <!--<PackageReference Include="Scaler" Version="1.0.2.7" />-->
    
  </ItemGroup>

</Project>